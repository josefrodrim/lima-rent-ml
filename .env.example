# Puerto de la API FastAPI (make serve)
API_PORT=8000

# URL de la API FastAPI local, usada por next.config.ts para reescribir
# /predict, /districts, etc. desde el frontend (make app) en desarrollo.
# En Vercel no se usa: Next.js y la API comparten dominio automáticamente.
API_URL=http://localhost:8000

# Tracking URI de MLflow (no se levanta en vivo durante el taller, ver docs/guion_taller.md)
MLFLOW_TRACKING_URI=./mlruns
