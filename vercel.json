{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    { "src": "api/main.py", "use": "@vercel/python", "config": { "maxDuration": 30 } }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/main.py" },
    { "src": "/predict", "dest": "/api/main.py" },
    { "src": "/predict/baseline", "dest": "/api/main.py" },
    { "src": "/districts", "dest": "/api/main.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
